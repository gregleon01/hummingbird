#!/usr/bin/env bash
set -e

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
VENV="${VENV:-$HOME/voice-overlay-venv}"

if [[ ! -d "$VENV" ]]; then
  echo "voice-overlay-venv not found at $VENV" >&2
  exit 1
fi

source "$VENV/bin/activate"
python "$ROOT_DIR/hummingbird.py" --model base "$@"
